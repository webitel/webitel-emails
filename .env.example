# Optional path to the YAML configuration file.
# CONFIG_FILE=config/config.example.yml

SERVICE_ADDR=127.0.0.1:8080
SERVICE_CONN_VERIFY_CERTS=false
# SERVICE_CONN_CA=/path/to/ca.pem
# SERVICE_CONN_CERT=/path/to/server.crt
# SERVICE_CONN_KEY=/path/to/server.key

LOG_LEVEL=info
LOG_JSON=false
LOG_OTEL=false
LOG_FILE=
LOG_CONSOLE=true

POSTGRES_DSN="postgres://postgres:postgres@127.0.0.1:5432/webitel?application_name=email-service&sslmode=disable&connect_timeout=10"

CONSUL_ADDR=127.0.0.1:8500

PUBSUB_URL="amqp://webitel:webitel@127.0.0.1:5672/"
PUBSUB_DRIVER=rabbitmq

LEADER_ELECTION_SESSION_TTL=15s
LEADER_ELECTION_LOCK_DELAY=1s
LEADER_ELECTION_RETRY_INTERVAL=10s
LEADER_ELECTION_ERROR_COOLDOWN=5s
LEADER_ELECTION_MONITOR_INTERVAL=5s

PROFILE_DISTRIBUTION_RECONCILE_INTERVAL=10s

IMAP_POLLING_TICK_INTERVAL=1s
IMAP_POLLING_MAX_CONCURRENCY=50
IMAP_POLLING_SHUTDOWN_TIMEOUT=10s
IMAP_POLLING_FETCH_BATCH_SIZE=50
IMAP_POLLING_MAX_MESSAGE_SIZE=41943040
IMAP_POLLING_MAX_MESSAGES_PER_POLL=500
IMAP_POLLING_MAX_OPEN_CONNECTIONS=500

MIME_MAX_BODY_SIZE=1048576
MIME_MAX_ATTACHMENT_SIZE=10485760
MIME_MAX_ATTACHMENTS_TOTAL_SIZE=20971520
MIME_MAX_ATTACHMENTS=15
